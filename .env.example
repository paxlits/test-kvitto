# Database
# По умолчанию SQLite — работает сразу, БД создаётся в папке проекта.
# Для PostgreSQL раскомментируй и прогони миграции:
#   alembic upgrade head
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/testkvitto
DATABASE_URL=sqlite+aiosqlite:///./kvitto.db

# Webhook
WEBHOOK_SECRET=secret_key

# Testing (optional)
# TEST_DATABASE_URL=sqlite+aiosqlite:///:memory: